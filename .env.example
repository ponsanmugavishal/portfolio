# Copy this file to .env.local for local testing. On Vercel, add these in
# Project -> Settings -> Environment Variables.

# Required for the contact form. Create a free key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered. Without your own domain in Resend,
# this must be the same email you used to sign up for Resend.
CONTACT_TO_EMAIL=ponsanmugavishalgowri@gmail.com

# Optional: raises the GitHub API limit for the live repos section
# (create a token with no scopes at https://github.com/settings/tokens)
GITHUB_TOKEN=
